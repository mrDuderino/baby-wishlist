# Public site URL (required in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
# Local: run `pnpm supabase:status` after `pnpm supabase:start`
# Production: copy from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional public contact links (leave empty if unused)
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_WHATSAPP_URL=

# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Optional Telegram bot notifications for new reservations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required in production for Vercel Cron → /api/cron/expire-reservations
# Generate with: openssl rand -hex 32
CRON_SECRET=
